import * as cdk from 'aws-cdk-lib';
import * as apigwv2 from 'aws-cdk-lib/aws-apigatewayv2';
import * as integrations from 'aws-cdk-lib/aws-apigatewayv2-integrations';
import * as lambda from 'aws-cdk-lib/aws-lambda';
import * as ssm from 'aws-cdk-lib/aws-ssm';
import { Construct } from 'constructs';

export class BillingConstruct extends Construct {
  constructor(scope: Construct, id: string) {
    super(scope, id);

    const stripeSecretKey = ssm.StringParameter.valueForStringParameter(
      this,
      '/{{name}}/stripe/secret-key'
    );
    const stripeWebhookSecret = ssm.StringParameter.valueForStringParameter(
      this,
      '/{{name}}/stripe/webhook-secret'
    );

    const webhookFn = new lambda.Function(this, 'StripeWebhookFunction', {
      runtime: lambda.Runtime.NODEJS_22_X,
      handler: 'index.handler',
      code: lambda.Code.fromInline(`
        exports.handler = async (event) => {
          // Replace with your compiled webhook handler
          console.log('Stripe webhook received', event);
          return { statusCode: 200, body: JSON.stringify({ received: true }) };
        };
      `),
      environment: {
        STRIPE_SECRET_KEY: stripeSecretKey,
        STRIPE_WEBHOOK_SECRET: stripeWebhookSecret,
      },
    });

    const api = new apigwv2.HttpApi(this, 'WebhookApi');
    api.addRoutes({
      path: '/webhooks/stripe',
      methods: [apigwv2.HttpMethod.POST],
      integration: new integrations.HttpLambdaIntegration('StripeWebhookIntegration', webhookFn),
    });

    new cdk.CfnOutput(this, 'StripeWebhookUrl', {
      value: `${api.apiEndpoint}/webhooks/stripe`,
    });
  }
}
