    "lint": "eslint src"
  },
  "dependencies": {
    "@angular/animations": "^{{_angular_animations}}",
    "@angular/cdk": "^{{_angular_cdk}}",
    "@angular/common": "^{{_angular_common}}",
    "@angular/compiler": "^{{_angular_compiler}}",
    "@angular/core": "^{{_angular_core}}",
    "@angular/forms": "^{{_angular_forms}}",
    "@angular/material": "^{{_angular_material}}",
    "@angular/platform-browser": "^{{_angular_platform_browser}}",
    "@angular/platform-browser-dynamic": "^{{_angular_platform_browser_dynamic}}",
    "@angular/router": "^{{_angular_router}}",
    "@m2s2/ng-lib": "^2.11.2",
    "@m2s2/tokens": "^2.2.2",
    "rxjs": "~{{rxjs}}",
    "tslib": "^{{tslib}}",
    "zone.js": "~{{zone_js}}"{{#if auth}},
    "aws-amplify": "^{{aws_amplify}}",
