    "eslint": "^{{eslint}}",
    "jest": "^{{jest}}",
    "jest-preset-angular": "^{{jest_preset_angular}}",
    "typescript": "^{{typescript}}",
    "typescript-eslint": "^{{typescript_eslint}}"
  }
